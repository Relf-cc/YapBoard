# --- docker compose settings (copy to .env next to docker-compose.yml) ---
# For local dev, use Site/.env and Bot/.env instead.

# --- Cloudflare Tunnel. Zero Trust > Networks > Tunnels > Create (cloudflared), copy the token from the
# docker command it shows. Public hostnames: yapboard.dev, portal.yapboard.dev, platform.yapboard.dev and
# api.yapboard.dev, each HTTP -> caddy:80 ---
TUNNEL_TOKEN=""

# --- Public URLs (HTTPS comes from Cloudflare). ---
# These are baked into the site at build time: run `docker compose up -d --build` after changing them.
NEXT_PUBLIC_SITE_URL="https://yapboard.dev"
PORTAL_URL="https://portal.yapboard.dev"
# The invite-only developer platform: bot developers integrating YapBoard's commands (Site/src/lib/platform.ts)
PLATFORM_URL="https://platform.yapboard.dev"
# The API's own host. Program members' bots are pointed at this, so it's stated rather than guessed from
# NEXT_PUBLIC_SITE_URL (Site/src/lib/platform.ts apiRoot).
API_URL="https://api.yapboard.dev"
COOKIE_DOMAIN=".yapboard.dev"

# --- Secrets: long random strings (openssl rand -base64 48). The change-me values are refused. ---
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
INTERNAL_API_SECRET="change-me-too"

# --- Login with Yapin'. Redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/callback ---
YAPIN_CLIENT_ID=""
YAPIN_CLIENT_SECRET=""

# --- The bot's token (starts with yb_). The site uses it too, to check who manages a server. ---
YAPPER_BOT_TOKEN=""
# The bot logs its ID on start (`docker compose logs bot`). Also baked in at build time.
NEXT_PUBLIC_BOT_ID=""

# --- Optional. Client listings read their downloads from GitHub releases; a token only raises the rate limit
# (60 requests an hour per IP becomes 5,000). Read-only, no scopes needed - a fine-grained token with public
# read access is enough. Nothing is ever written to GitHub. ---
GITHUB_TOKEN=""

# --- "Report a bug" in the footer posts to this Kern stream, straight from the browser (public stream: no secret
# here, ever). Baked in at build time. Leave blank to hide the button. ---
NEXT_PUBLIC_BUG_REPORT_URL="https://streams.relf.cc/kern/9193cd4b7891377b3caa4f430b25d41d3785b5d0909ee20d94c8ad35a54009bf"

# --- Comma separated Yapin' user IDs that are always staff (admins) ---
STAFF_IDS=""

# --- Stripe, for YapBoard Pro. Pro is off unless all four are set (Site/src/lib/env.ts). ---
# Prefer a RESTRICTED key (rk_live_…) over a secret key, scoped to Billing/Checkout/Customer writes.
STRIPE_SECRET_KEY=""
# Not read by anything today: Checkout and the Customer Portal are hosted by Stripe, so no Stripe.js
# runs in the browser. Leave it blank unless you add one - and note that NEXT_PUBLIC_* is baked in at
# build time, so it would then need a compose build arg, not just this line.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Dashboard -> Developers -> Webhooks. Endpoint: https://yapboard.dev/api/stripe/webhook
# (not under /api/internal/*, which the Caddyfile 404s from outside - Stripe must reach it).
# Per endpoint, so the live and test secrets differ, and set the endpoint's API version to the one
# pinned in Site/src/lib/stripe.ts - the handler reads fields off these objects.
# Events: checkout.session.completed, customer.subscription.created/updated/deleted, invoice.paid,
# invoice.payment_failed, charge.dispute.created, charge.refunded, radar.early_fraud_warning.created
STRIPE_WEBHOOK_SECRET=""
# Base plan (one server, one bot, one client) and the extra-listing slot, which is bought with a
# quantity. Separate Stripe Products, so invoice lines name them apart. Both need a tax_code.
#
# Every Price needs metadata `yapboard_role` = base | slot: the webhook finds the base line and counts
# slots by that field alone, never by an id from here, because repricing means creating a new Price.
# `node Site/scripts/setup-prices.mjs` makes an account match; check-prices.mjs verifies one.
#
#   yapboard_pro_monthly    $2.99 / month   role=base
#   yapboard_pro_annual    $29.99 / year    role=base
#   yapboard_slot_monthly   $1.00 / month   role=slot
#   yapboard_slot_annual   $10.00 / year    role=slot
#
# There is no free trial: the first period is charged at checkout.
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_SLOT_MONTHLY=""
STRIPE_PRICE_SLOT_ANNUAL=""
