# --- docker compose settings (copy to .env next to docker-compose.yml) ---
# For local dev, use Site/.env and Bot/.env instead.

# --- Cloudflare Tunnel. Zero Trust > Networks > Tunnels > Create (cloudflared), copy the token from the
# docker command it shows. Public hostnames: yapboard.dev, portal.yapboard.dev and api.yapboard.dev, each
# HTTP -> caddy:80 ---
TUNNEL_TOKEN=""

# --- Public URLs (HTTPS comes from Cloudflare). ---
# These are baked into the site at build time: run `docker compose up -d --build` after changing them.
NEXT_PUBLIC_SITE_URL="https://yapboard.dev"
PORTAL_URL="https://portal.yapboard.dev"
COOKIE_DOMAIN=".yapboard.dev"

# --- Secrets: long random strings (openssl rand -base64 48). The change-me values are refused. ---
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
INTERNAL_API_SECRET="change-me-too"

# --- Login with Yapin'. Redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/callback ---
YAPIN_CLIENT_ID=""
YAPIN_CLIENT_SECRET=""

# --- The bot's token (starts with yb_). The site uses it too, to check who manages a server. ---
YAPPER_BOT_TOKEN=""
# The bot logs its ID on start (`docker compose logs bot`). Also baked in at build time.
NEXT_PUBLIC_BOT_ID=""

# --- Comma separated Yapin' user IDs that are always staff (admins) ---
STAFF_IDS=""
