# --- The bot's token (Yapin' -> Settings -> Developer). Starts with yb_ ---
# The site uses the same token (Site/.env YAPPER_BOT_TOKEN) to check who manages a server.
YAPPER_BOT_TOKEN=""

# --- Where the site runs. The bot calls <YAPBOARD_URL>/api/internal/* ---
YAPBOARD_URL="http://localhost:3000"

# --- Must match INTERNAL_API_SECRET in Site/.env (16+ characters) ---
INTERNAL_API_SECRET=""
