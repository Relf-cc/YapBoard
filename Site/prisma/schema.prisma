// SQLite keeps dev zero-setup. For production switch the provider to "postgresql";
// the schema only uses types both support (status fields are plain strings for that reason).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A Yapin' account that has logged in. `id` is the Yapin' user id (stable; usernames can change).
model User {
  id          String    @id
  username    String
  displayName String?
  avatarUrl   String?
  /// USER | STAFF | ADMIN
  role        String    @default("USER")
  bannedAt    DateTime?
  banReason   String?
  /// The Stripe Customer (cus_…) for this account, made the first time they open checkout.
  /// Stripe's Customer is the ownership boundary billing webhooks resolve to, so this is the one
  /// link between a Stripe event and a YapBoard account (src/lib/stripe.ts).
  stripeCustomerId String? @unique
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime  @default(now())

  servers           Server[]
  reports           Report[]           @relation("reporter")
  handled           Report[]           @relation("handler")
  bumps             Bump[]
  votes             Vote[]
  auditEntries      AuditLog[]
  sessions          Session[]
  bots              BotListing[]
  botBumps          BotBump[]
  clients           ClientListing[]
  clientBumps       ClientBump[]
  announcements     Announcement[]
  announcementsSeen AnnouncementSeen[]
  broadcasts        Broadcast[]
  botDms            BotDm[]
  uploads           Upload[]
  proSubscriptions  ProSubscription[]
  billingAlerts     BillingAlert[]
  platformMember    PlatformMember?
  platformInvitesSent     PlatformInvite[]   @relation("platformInviter")
  platformInvitesRedeemed PlatformInvite[]   @relation("platformRedeemer")
}

/// One logged-in browser. The cookie carries its id (signed); deleting the row logs that browser out.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

/// A listed server. `id` is the Yapin' server id.
model Server {
  id            String    @id
  name          String
  iconUrl       String?
  bannerUrl     String?
  /// One line shown on cards (max 140)
  summary       String
  /// Full description shown on /view (max 2000)
  description   String
  inviteUrl     String
  language      String    @default("en")
  nsfw          Boolean   @default(false)
  /// Accent used on the server page (hex)
  accent        String    @default("#ff6b4a")
  /// Hero backdrop on the listing page: GLOW | GRID | WAVE | FLAT (src/lib/client-fields.ts THEMES).
  /// Pro only - a free listing keeps the default header, so this is ignored until the listing is covered.
  theme         String    @default("GLOW")
  /// Up to 6 https screenshots, as a JSON array of strings (SQLite has no array type). Pro only.
  screenshots   String?
  /// Extra buttons beside Join, as a JSON array of {label, url} (src/lib/pro-fields.ts). Pro only.
  links         String?
  /// PUBLIC | UNLISTED (owner hid it) | HIDDEN (staff hid it) | REMOVED
  status        String    @default("PUBLIC")
  statusNote    String?
  memberCount   Int       @default(0)
  bumpCount     Int       @default(0)
  bumpedAt      DateTime?
  /// Sort key for "recently bumped": the last bump, moved forward a little by votes since then (src/lib/votes.ts)
  rankedAt      DateTime?
  /// Staff turned voting off for this server
  votingOff     Boolean   @default(false)
  /// Where /bump was last used, and when. Broadcasts go to this channel (src/lib/broadcasts.ts).
  bumpChannelId String?
  bumpChannelAt DateTime?
  /// Nobody here wants YapBoard's announcements: broadcasts skip this server.
  broadcastsOff Boolean   @default(false)
  views         Int       @default(0)
  joins         Int       @default(0)
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tags       ServerTag[]
  badges     ServerBadge[]
  bumps      Bump[]
  votes      Vote[]
  reports    Report[]
  deliveries BroadcastDelivery[]
  supportFor BotListing[]        @relation("botSupport")

  @@index([status, bumpedAt])
  @@index([status, rankedAt])
  @@index([status, memberCount])
  @@index([ownerId])
}

/// One badge on a server. A server can hold several; `kind` is a key of BADGES in src/lib/badges.ts.
model ServerBadge {
  serverId    String
  kind        String
  grantedAt   DateTime @default(now())
  /// The staff member who granted it. AuditLog keeps the full trail, including removals.
  grantedById String?
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([serverId, kind])
  @@index([kind])
}

model Tag {
  id      Int         @id @default(autoincrement())
  /// normalised: lowercase, a-z 0-9 and -, max 24
  name    String      @unique
  servers ServerTag[]
  bots    BotTag[]
  clients ClientTag[]
}

model ServerTag {
  serverId String
  tagId    Int
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([serverId, tagId])
  @@index([tagId])
}

model Bump {
  id        Int      @id @default(autoincrement())
  serverId  String
  userId    String
  /// bot | web
  source    String   @default("bot")
  /// The platform app that carried it, when a program member's bot did (src/lib/platform.ts). Null for
  /// YapBoard's own bot and for the site. Not a relation: a bump is history and outlives any app, so this
  /// is kept as a plain id even if the app is deleted.
  appId     String?
  createdAt DateTime @default(now())
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([serverId, createdAt])
  /// "What has this app carried, and how far does it reach?"
  @@index([appId, createdAt])
}

/// A vote for a server. Never deleted by staff, only revoked, so it can be restored (src/lib/votes.ts).
model Vote {
  id         Int       @id @default(autoincrement())
  serverId   String
  userId     String
  /// Keyed hash of the voter's IP, to spot (and optionally limit) many accounts voting from one network
  ipHash     String
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  /// Which staff action revoked it: server | user. Restoring undoes exactly that.
  revokedFor String?
  server     Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id])

  @@index([serverId, createdAt])
  @@index([userId, createdAt])
  @@index([ipHash, createdAt])
}

/// Settings staff change from the portal, as JSON per key (e.g. "voting").
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Abuse reports and removal requests, reviewed on portal.yapboard.dev
model Report {
  id          String      @id @default(cuid())
  /// ABUSE | REMOVAL
  kind        String
  /// spam, scam, nsfw, hate, illegal, impersonation, other  |  owner_request, not_owner, outdated, other
  reason      String
  details     String
  contact     String?
  /// Exactly one of serverId / botId / clientId is set (src/lib/reports.ts).
  serverId    String?
  server      Server?     @relation(fields: [serverId], references: [id], onDelete: Cascade)
  botId       String?
  bot         BotListing? @relation(fields: [botId], references: [id], onDelete: Cascade)
  clientId    String?
  client      ClientListing? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reporterId  String?
  reporter    User?       @relation("reporter", fields: [reporterId], references: [id])
  /// OPEN | ACTIONED | DISMISSED
  status      String      @default("OPEN")
  resolution  String?
  handledById String?
  handledBy   User?       @relation("handler", fields: [handledById], references: [id])
  handledAt   DateTime?
  createdAt   DateTime    @default(now())

  @@index([status, kind, createdAt])
  @@index([serverId])
  @@index([botId])
  @@index([clientId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  /// e.g. report.dismiss, server.hide, server.remove, server.restore, user.ban, user.unban, staff.grant
  action     String
  targetType String
  targetId   String
  note       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/**
 * ---------------- Announcements (src/lib/announcements.ts) ----------------
 */

/// A site-wide notice staff write in the portal: a bar across the top of every page, or a dialog shown once.
model Announcement {
  id             String    @id @default(cuid())
  /// BANNER (a bar at the top) | MODAL (a dialog, shown once per person)
  kind           String    @default("BANNER")
  title          String
  body           String
  linkUrl        String?
  linkLabel      String?
  /// accent | info | warn | danger
  tone           String    @default("accent")
  /// everyone | users (logged in) | new (see newWithinHours)
  audience       String    @default("everyone")
  /// audience "new": accounts younger than this. Logged-out visitors always count as new.
  newWithinHours Int       @default(72)
  /// Banners only. A banner that isn't dismissible has no close button and comes back on every page.
  dismissible    Boolean   @default(true)
  /// Off: written but not shown. Staff turn it on when it's ready.
  active         Boolean   @default(false)
  startsAt       DateTime?
  endsAt         DateTime?
  authorId       String
  author         User      @relation(fields: [authorId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  seen AnnouncementSeen[]

  @@index([active, kind])
}

/// One person has closed one announcement. Logged-out visitors keep the same thing in their browser instead.
model AnnouncementSeen {
  announcementId String
  userId         String
  seenAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId])
}

/**
 * ---------------- Bot broadcasts (src/lib/broadcasts.ts) ----------------
 */

/// A message staff send through the bot to every server that has used /bump.
model Broadcast {
  id         String    @id @default(cuid())
  title      String
  body       String
  linkUrl    String?
  linkLabel  String?
  /// DRAFT | SENDING | SENT | CANCELLED
  status     String    @default("DRAFT")
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  deliveries BroadcastDelivery[]

  @@index([status, createdAt])
}

/// One server's copy of a broadcast. The bot claims PENDING rows, posts them and reports back.
model BroadcastDelivery {
  id          Int       @id @default(autoincrement())
  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  serverId    String
  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// The channel as it was when the broadcast was queued, so a later /bump elsewhere doesn't move it.
  channelId   String
  /// PENDING | CLAIMED | SENT | FAILED
  status      String    @default("PENDING")
  error       String?
  /// When the bot took this row. A claim left too long is handed out again (src/lib/broadcasts.ts).
  claimedAt   DateTime?
  sentAt      DateTime?

  @@unique([broadcastId, serverId])
  @@index([status, claimedAt])
}

/// One DM the bot owes someone, currently a bot listing review decision (src/lib/bot-dms.ts).
/// The site queues a row; the bot claims PENDING rows, sends them and reports back, like broadcasts.
/// The dashboard stays the real record - a DM is a nudge, so one that can't be delivered is logged, not retried forever.
model BotDm {
  id        Int       @id @default(autoincrement())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// bot.approved | bot.denied | client.approved | client.denied
  kind      String
  title     String
  body      String
  linkUrl   String?
  linkLabel String?
  /// PENDING | CLAIMED | SENT | FAILED
  status    String    @default("PENDING")
  error     String?
  /// When the bot took this row. A claim left too long is handed out again (src/lib/bot-dms.ts).
  claimedAt DateTime?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, claimedAt])
}

/**
 * ---------------- Bot listings (src/lib/bots.ts) ----------------
 */

/// A listed bot. `id` is the bot's Yapin' user id, the same one people paste into Server settings → Bots.
model BotListing {
  id              String    @id
  name            String
  avatarUrl       String?
  /// One line shown on cards (max 140)
  summary         String
  /// Full description shown on /bots/<id> (max 2000)
  description     String
  /// Optional "add me" link, for bots that have their own page
  inviteUrl       String?
  /// Message prefix, if it has one
  prefix          String?
  website         String?
  /// What it's written with, free text (e.g. "yapper.js")
  library         String?
  language        String    @default("en")
  nsfw            Boolean   @default(false)
  accent          String    @default("#ff6b4a")
  /// PENDING | PUBLIC | UNLISTED | DENIED | HIDDEN | REMOVED. New listings wait for staff (lib/bots.ts).
  status          String    @default("PENDING")
  /// Why staff denied, hid or removed it. Shown to the lister on their manage page.
  statusNote      String?
  /// Did the lister ask for unlisted? Remembered so approving sends it where they wanted.
  requestedUnlisted Boolean @default(false)
  /// Set when staff approved it, so the queue can show how long a decision took.
  reviewedAt      DateTime?
  reviewedById    String?
  serverCount     Int       @default(0)
  views           Int       @default(0)
  /// Clicks on "Add to your server"
  adds            Int       @default(0)
  bumpCount       Int       @default(0)
  bumpedAt        DateTime?
  /// The bot's support server. Set from a Yapin' server its lister manages; linked when that server is listed here.
  supportServerId String?
  supportServer   Server?   @relation("botSupport", fields: [supportServerId], references: [id], onDelete: SetNull)
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tags    BotTag[]
  badges  BotBadge[]
  bumps   BotBump[]
  reports Report[]

  @@index([status, bumpedAt])
  @@index([status, serverCount])
  /// The review queue: oldest PENDING first.
  @@index([status, createdAt])
  @@index([ownerId])
}

/// Same badges as servers (src/lib/badges.ts), granted on a bot instead.
model BotBadge {
  botId       String
  kind        String
  grantedAt   DateTime   @default(now())
  grantedById String?
  bot         BotListing @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([botId, kind])
  @@index([kind])
}

model BotTag {
  botId String
  tagId Int
  bot   BotListing @relation(fields: [botId], references: [id], onDelete: Cascade)
  tag   Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([botId, tagId])
  @@index([tagId])
}

model BotBump {
  id        Int        @id @default(autoincrement())
  botId     String
  userId    String
  /// The platform app that carried it, as on Bump.
  appId     String?
  createdAt DateTime   @default(now())
  bot       BotListing @relation(fields: [botId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])

  @@index([botId, createdAt])
  @@index([appId, createdAt])
}

/**
 * ---------------- Client listings (src/lib/clients.ts) ----------------
 */

/// A listed client: somebody's own build of Yapin', shipped as its own executable rather than a bot or a server.
/// Nothing about it lives on Yapin', so unlike a server or a bot there is no id to key it on - it gets a cuid and
/// a slug for its URL. Everything else (review queue, badges, tags, bumps, reports) works the way bots do.
model ClientListing {
  id          String  @id @default(cuid())
  /// The URL: /clients/<slug>. Made from the name on create, and kept when the name changes so links survive.
  slug        String  @unique
  name        String
  iconUrl     String?
  bannerUrl   String?
  /// One line shown on cards (max 140)
  summary     String
  /// Full description shown on /clients/<slug> (max 4000)
  description String
  /// Up to 6 https screenshots, as a JSON array of strings (SQLite has no array type).
  screenshots String?
  /// Which platforms the lister says it targets, as a JSON array of PLATFORM keys. Cards read this.
  platforms   String?
  website     String?
  /// Where the code is, when it isn't the GitHub repo below (a mirror, a GitLab page).
  sourceUrl   String?
  /// What it's built on, free text (e.g. "Electron", "Tauri")
  framework   String?
  language    String  @default("en")
  nsfw        Boolean @default(false)
  accent      String  @default("#ff6b4a")
  /// Hero backdrop on the listing page: GLOW | GRID | WAVE | FLAT (src/lib/clients.ts THEMES)
  theme       String  @default("GLOW")

  /// GITHUB (downloads come from releases/latest) | MANUAL (the lister keeps the links themselves)
  releaseSource String @default("GITHUB")
  /// "owner/repo" when releaseSource is GITHUB. Releases are read from it; nothing is ever written back.
  repo          String?
  /// The tag of the release currently shown, e.g. "v1.4.2".
  version       String?
  /// The release's own title, when it has one that isn't just the tag.
  releaseName   String?
  /// The release notes, shown as the changelog. Markdown-ish, rendered as plain text with links.
  changelog     String?
  releaseUrl    String?
  releasedAt    DateTime?
  /// When the release was last read from GitHub, and what went wrong if it couldn't be.
  releaseSyncedAt DateTime?
  releaseError    String?

  /// PENDING | PUBLIC | UNLISTED | DENIED | HIDDEN | REMOVED. New listings wait for staff, like bots.
  status            String    @default("PENDING")
  statusNote        String?
  requestedUnlisted Boolean   @default(false)
  reviewedAt        DateTime?
  reviewedById      String?
  /// When the lister accepted the YapBoard client terms and Yapin's terms in the dialog before submitting.
  termsAgreedAt     DateTime?

  views     Int       @default(0)
  /// Clicks on a download button, across every file.
  downloads Int       @default(0)
  bumpCount Int       @default(0)
  bumpedAt  DateTime?

  /// The client's support or community server, as a Yapin' server id the lister runs.
  supportServerId String?
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tags    ClientTag[]
  badges  ClientBadge[]
  bumps   ClientBump[]
  files   ClientDownload[]
  reports Report[]

  @@index([status, bumpedAt])
  @@index([status, downloads])
  /// The review queue: oldest PENDING first.
  @@index([status, createdAt])
  @@index([ownerId])
}

/// One file people can download for a client. Either read from a GitHub release or typed in by the lister.
model ClientDownload {
  id       Int           @id @default(autoincrement())
  clientId String
  client   ClientListing @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// windows | mac | linux | android | ios | web | other (src/lib/platforms.ts)
  platform String
  /// The file's extension as a label: exe, dmg, deb, AppImage… Blank for a plain link.
  kind     String        @default("")
  /// x64 | arm64 | x86 | universal | '' when the name doesn't say
  arch     String        @default("")
  /// What the button says, e.g. "YapinPlus-1.4.2-x64.exe"
  label    String
  url      String
  /// Bytes, when the release says. Null for links the lister typed in.
  size     Int?
  /// True: this row came from the GitHub release and is replaced on every sync. False: the lister owns it.
  managed  Boolean       @default(true)
  /// Manual rows sort by this, then by label.
  position Int           @default(0)
  /// Clicks on this file's button.
  clicks   Int           @default(0)

  @@index([clientId, platform])
}

/// Same badges as servers and bots (src/lib/badges.ts), granted on a client.
model ClientBadge {
  clientId    String
  kind        String
  grantedAt   DateTime      @default(now())
  grantedById String?
  client      ClientListing @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, kind])
  @@index([kind])
}

model ClientTag {
  clientId String
  tagId    Int
  client   ClientListing @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag      Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
  @@index([tagId])
}

model ClientBump {
  id        Int           @id @default(autoincrement())
  clientId  String
  userId    String
  /// The platform app that carried it, as on Bump.
  appId     String?
  createdAt DateTime      @default(now())
  client    ClientListing @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  @@index([clientId, createdAt])
  @@index([appId, createdAt])
}

/// An image somebody uploaded on YapBoard, rather than linking from somewhere else.
///
/// The bytes live in the database so an upload travels with the volume and with any backup of it, the same
/// way everything else here does - there is no second store to keep in sync. They're small on purpose (see
/// MAX_UPLOAD_BYTES in src/lib/upload-fields.ts); if this ever grows past a few hundred megabytes, move the
/// `data` column to object storage and keep the rest of the row as it is.
///
/// Served at /u/<id>.<ext> (src/app/u/[file]/route.ts), which is what a listing stores in place of a link.
/// Rows nothing points at are swept a day after they're made (sweepUploads in src/lib/uploads.ts), so an
/// image picked and then replaced in the form doesn't stay forever.
model Upload {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// image/png | image/jpeg | image/webp | image/gif, read from the file's own first bytes, never from the browser.
  mime      String
  /// png | jpg | webp | gif - the extension the URL ends in, so the path still looks like a file.
  ext       String
  bytes     Int
  /// What it was picked for: icon | banner | screenshot. Sets the size limit, and tells staff what they're looking at.
  kind      String
  data      Bytes
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([createdAt])
}

/**
 * ---------------- YapBoard Pro billing (src/lib/stripe.ts, src/lib/pro.ts) ----------------
 *
 * Stripe holds the truth about money; these tables hold only what the site needs to answer
 * "is this listing on Pro?" without calling Stripe on every page view. Everything here is
 * written by the webhook (src/app/api/stripe/webhook/route.ts), never by a page.
 */

/// One Stripe subscription to YapBoard Pro. Entitlement is worked out from these rows by isPro()
/// in src/lib/pro.ts - nothing else should read `status` directly.
model ProSubscription {
  /// The Stripe Subscription id (sub_…). The primary key, so a replayed webhook upserts this row
  /// instead of making a second one.
  id               String    @id
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Stripe's own status, stored verbatim: active | trialing | past_due | canceled | unpaid |
  /// incomplete | incomplete_expired | paused. Mapped to entitlement in src/lib/pro.ts.
  status           String
  /// The Price it's on, so the manage page can say "£4/month" without a round trip.
  priceId          String
  /// monthly | annual, read from the Price's metadata when the subscription is written.
  cycle            String    @default("monthly")
  /// Extra listing slots bought on top of the base plan: the quantity of the slot Price on the
  /// Stripe subscription. The base plan always covers one server, one bot and one client; each
  /// extra slot covers one more listing of any kind. Worked out in src/lib/pro.ts.
  extraSlots       Int       @default(0)
  /// End of the period already paid for. Pro lasts until here even once a cancellation is scheduled.
  currentPeriodEnd DateTime?
  /// Set when the owner has asked to cancel but the paid period hasn't run out yet.
  cancelAt         DateTime?
  canceledAt       DateTime?
  trialEnd         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assignments      ProAssignment[]

  @@index([userId, status])
  @@index([currentPeriodEnd])
}

/// One listing the owner has put under their Pro plan.
///
/// Pro is bought per listing, so the site has to know *which* ones: a plan covers one server, one
/// bot and one client, plus one more listing of any kind per extra slot. The owner chooses, and can
/// change their mind - moving a slot is free and immediate.
///
/// Rows are never deleted to make a plan fit. If a downgrade leaves more listings assigned than
/// there are slots, the extras stop counting (oldest assignment keeps the slot) and the owner is
/// asked to pick; the row stays so re-adding a slot restores it. Same rule as everything else here:
/// hidden, kept, restored - never deleted.
model ProAssignment {
  id             String          @id @default(cuid())
  subscriptionId String
  subscription   ProSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// server | bot | client
  kind           String
  /// Server.id, BotListing.id or ClientListing.id. Not a relation: one column can't point at three
  /// tables, and the owner check happens before the row is written (src/app/api/billing/slots).
  listingId      String
  assignedAt     DateTime        @default(now())

  /// A listing can only be under one plan at a time.
  @@unique([kind, listingId])
  @@index([subscriptionId, assignedAt])
}

/// Every Stripe webhook we've already handled. Stripe retries until it gets a 2xx and can deliver
/// the same event twice, so the handler claims an id here first and does nothing if it's taken.
model StripeEvent {
  /// Stripe's event id (evt_…).
  id         String    @id
  type       String
  receivedAt DateTime  @default(now())
  handledAt  DateTime?
  /// Why handling failed, when it did. The row stays so a retry can be told apart from a first try.
  error      String?

  @@index([type, receivedAt])
}

/// Something about a payment that a person needs to look at: a dispute, a refund, a fraud warning,
/// or a payment that keeps failing. Shown in the staff portal.
///
/// This exists because a listing can be paying us while staff are deciding whether to remove it,
/// and because a dispute means the money is already gone - neither is something to find out about
/// from a Stripe email weeks later.
model BillingAlert {
  id         Int       @id @default(autoincrement())
  /// Null when the Stripe customer couldn't be matched to an account, which is itself worth seeing.
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// dispute | refund | fraud_warning | payment_failed
  kind       String
  /// The Stripe object it came from (ch_…, dp_…, in_…), so staff can find it in the Dashboard.
  stripeId   String
  detail     String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([resolvedAt, createdAt])
  @@index([userId])
}

/**
 * ---------------- Developer platform (src/lib/platform.ts) ----------------
 *
 * platform.yapboard.dev, an invite-only program: a Yapin' bot developer we've admitted can put YapBoard's
 * commands (`/bump`, listing lookups, search) inside their own bot, by calling the partner API with a key
 * they mint there.
 *
 * Invite-only because these calls act on other people's listings, so the bot sending them has to be one we
 * can name and turn off. Three rows carry that: the invite staff wrote, the member it admitted, and the app
 * (one bot) whose keys the API checks.
 */

/// One invite to the program. Staff write it in the portal and hand the code to a developer; redeeming it at
/// platform.yapboard.dev makes a PlatformMember. The code is kept in full (not hashed) so staff can read it
/// back and resend it - it only ever grants what a staff member already decided to grant.
model PlatformInvite {
  id           String    @id @default(cuid())
  /// What gets typed in to redeem it: YB-XXXX-XXXX (src/lib/platform.ts).
  code         String    @unique
  /// Who it's for, in staff's own words ("@ellie, writes Yapper.js bots"). The invite isn't bound to an
  /// account until it's redeemed, so this is the only record of intent.
  note         String?
  /// Optional: only this Yapin' user id can redeem it. Blank means whoever holds the code.
  forUserId    String?
  /// How many apps the member it admits may register.
  appLimit     Int       @default(2)
  /// Which scopes the member starts with, as a JSON array of SCOPE keys.
  scopes       String    @default("[]")
  invitedById  String
  invitedBy    User      @relation("platformInviter", fields: [invitedById], references: [id])
  expiresAt    DateTime?
  redeemedAt   DateTime?
  redeemedById String?
  redeemedBy   User?     @relation("platformRedeemer", fields: [redeemedById], references: [id])
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  member PlatformMember?

  @@index([redeemedAt, createdAt])
}

/// A developer who has been admitted. Without a row here, platform.yapboard.dev shows the invite wall -
/// that is the whole of "invite only".
model PlatformMember {
  userId     String    @id
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ACTIVE | SUSPENDED. Suspended keeps everything but stops every key at the door.
  status     String    @default("ACTIVE")
  /// Why staff suspended them. Shown to the developer on their overview.
  statusNote String?
  /// How many apps they may register. Raised per member in the portal.
  appLimit   Int       @default(2)
  /// The scopes staff allow them, as a JSON array of SCOPE keys. An app can only ask for these.
  scopes     String    @default("[]")
  /// The invite this came from. Null for members added straight from the portal.
  inviteId   String?         @unique
  invite     PlatformInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  joinedAt   DateTime  @default(now())

  apps PlatformApp[]

  @@index([status, joinedAt])
}

/// One bot putting YapBoard's commands in front of its own users. `botId` is the bot's Yapin' user id, so a
/// bump made through the API can be traced back to the bot that sent it.
model PlatformApp {
  id         String  @id @default(cuid())
  /// The bot's Yapin' user id. One app per bot, across the whole program.
  botId      String  @unique
  name       String
  /// One line about what it does with the commands, for staff reviewing the program.
  summary    String  @default("")
  /// Where to reach the developer about this app (a support server invite, an issue tracker).
  contactUrl String?
  /// What it may call, as a JSON array of SCOPE keys. Always a subset of the member's own scopes.
  scopes     String  @default("[]")
  /// ACTIVE | PAUSED (the developer stopped it) | SUSPENDED (staff did) | REVOKED (gone for good)
  status     String  @default("ACTIVE")
  statusNote String?
  /// Totals, so the overview doesn't have to add up PlatformUsage on every page view.
  calls      Int     @default(0)
  errors     Int     @default(0)
  lastCallAt DateTime?
  ownerId    String
  owner      PlatformMember @relation(fields: [ownerId], references: [userId], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  keys     PlatformKey[]
  usage    PlatformUsage[]
  outcomes PlatformOutcome[]

  @@index([ownerId, createdAt])
  @@index([status, lastCallAt])
}

/// One API key for one app. Only the hash is kept, so a key shown once can never be shown again - the
/// developer mints a new one and revokes the old, which is also how rotation works.
model PlatformKey {
  id         String    @id @default(cuid())
  appId      String
  app        PlatformApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  /// What it's for, in the developer's words ("prod", "my laptop").
  label      String    @default("")
  /// The first few characters, so a key can be told apart in the list: ybp_AbC12345…
  prefix     String
  /// sha256 of the whole key. Unique, so two keys can never collide.
  hash       String    @unique
  lastUsedAt DateTime?
  /// Revoked keys stay: a request that arrives with one should read as "revoked", not "never existed".
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([appId, createdAt])
}

/// One app's calls to one endpoint on one UTC day. Written by the API (src/lib/platform.ts), read by the
/// developer's app page and the portal. Counts only - no request bodies, nothing about who typed the command.
model PlatformUsage {
  id       Int      @id @default(autoincrement())
  appId    String
  app      PlatformApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  /// Midnight UTC of the day being counted.
  day      DateTime
  /// The endpoint key: bump | listing | search | bots (src/lib/platform.ts ENDPOINTS).
  endpoint String
  calls    Int      @default(0)
  /// Calls that answered 4xx or 5xx. A key that only errors is usually a broken integration, not abuse.
  errors   Int      @default(0)
  /// Calls that answered 200 with `ok: false` — a cooldown, an unlisted server, the wrong server. Not
  /// failures: a bot whose bumps are mostly refused is working correctly and asking too often.
  refused  Int      @default(0)
  /// Total handler time in milliseconds, so the average is msTotal/calls. Sum rather than average because
  /// sums add up across days and endpoints and averages don't.
  msTotal  Int      @default(0)

  @@unique([appId, day, endpoint])
  @@index([appId, day])
}

/// Why one app's calls to one endpoint ended, counted per UTC day: `ok`, a refusal reason (`cooldown`,
/// `not_found`, `not_listed`, `wrong_server`, `banned`) or an HTTP status (`http_401`, `http_429`…).
///
/// A row per outcome rather than a column per outcome, so a new refusal reason needs no migration. This is
/// the detail behind PlatformUsage's four counters; both are written by recordCall in src/lib/platform.ts,
/// in the same call, so they can't drift.
///
/// It earns its keep twice over. A developer sees which answer their command actually gets — mostly
/// cooldowns means they're asking too often, `not_found` means they're reaching servers that aren't listed
/// yet (and should be seeing the add link). Staff see `wrong_server` piling up, which is what probing for
/// other people's bots looks like.
model PlatformOutcome {
  id       Int         @id @default(autoincrement())
  appId    String
  app      PlatformApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  day      DateTime
  endpoint String
  outcome  String
  count    Int         @default(0)

  @@unique([appId, day, endpoint, outcome])
  @@index([appId, day])
  @@index([outcome, day])
}
