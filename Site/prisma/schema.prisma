// SQLite keeps dev zero-setup. For production switch the provider to "postgresql";
// the schema only uses types both support (status fields are plain strings for that reason).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A Yapin' account that has logged in. `id` is the Yapin' user id (stable; usernames can change).
model User {
  id          String    @id
  username    String
  displayName String?
  avatarUrl   String?
  /// USER | STAFF | ADMIN
  role        String    @default("USER")
  bannedAt    DateTime?
  banReason   String?
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime  @default(now())

  servers           Server[]
  reports           Report[]           @relation("reporter")
  handled           Report[]           @relation("handler")
  bumps             Bump[]
  votes             Vote[]
  auditEntries      AuditLog[]
  sessions          Session[]
  bots              BotListing[]
  botBumps          BotBump[]
  clients           ClientListing[]
  clientBumps       ClientBump[]
  announcements     Announcement[]
  announcementsSeen AnnouncementSeen[]
  broadcasts        Broadcast[]
  botDms            BotDm[]
  uploads           Upload[]
}

/// One logged-in browser. The cookie carries its id (signed); deleting the row logs that browser out.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

/// A listed server. `id` is the Yapin' server id.
model Server {
  id            String    @id
  name          String
  iconUrl       String?
  bannerUrl     String?
  /// One line shown on cards (max 140)
  summary       String
  /// Full description shown on /view (max 2000)
  description   String
  inviteUrl     String
  language      String    @default("en")
  nsfw          Boolean   @default(false)
  /// Accent used on the server page (hex)
  accent        String    @default("#ff6b4a")
  /// PUBLIC | UNLISTED (owner hid it) | HIDDEN (staff hid it) | REMOVED
  status        String    @default("PUBLIC")
  statusNote    String?
  memberCount   Int       @default(0)
  bumpCount     Int       @default(0)
  bumpedAt      DateTime?
  /// Sort key for "recently bumped": the last bump, moved forward a little by votes since then (src/lib/votes.ts)
  rankedAt      DateTime?
  /// Staff turned voting off for this server
  votingOff     Boolean   @default(false)
  /// Where /bump was last used, and when. Broadcasts go to this channel (src/lib/broadcasts.ts).
  bumpChannelId String?
  bumpChannelAt DateTime?
  /// Nobody here wants YapBoard's announcements: broadcasts skip this server.
  broadcastsOff Boolean   @default(false)
  views         Int       @default(0)
  joins         Int       @default(0)
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tags       ServerTag[]
  badges     ServerBadge[]
  bumps      Bump[]
  votes      Vote[]
  reports    Report[]
  deliveries BroadcastDelivery[]
  supportFor BotListing[]        @relation("botSupport")

  @@index([status, bumpedAt])
  @@index([status, rankedAt])
  @@index([status, memberCount])
  @@index([ownerId])
}

/// One badge on a server. A server can hold several; `kind` is a key of BADGES in src/lib/badges.ts.
model ServerBadge {
  serverId    String
  kind        String
  grantedAt   DateTime @default(now())
  /// The staff member who granted it. AuditLog keeps the full trail, including removals.
  grantedById String?
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([serverId, kind])
  @@index([kind])
}

model Tag {
  id      Int         @id @default(autoincrement())
  /// normalised: lowercase, a-z 0-9 and -, max 24
  name    String      @unique
  servers ServerTag[]
  bots    BotTag[]
  clients ClientTag[]
}

model ServerTag {
  serverId String
  tagId    Int
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([serverId, tagId])
  @@index([tagId])
}

model Bump {
  id        Int      @id @default(autoincrement())
  serverId  String
  userId    String
  /// bot | web
  source    String   @default("bot")
  createdAt DateTime @default(now())
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([serverId, createdAt])
}

/// A vote for a server. Never deleted by staff, only revoked, so it can be restored (src/lib/votes.ts).
model Vote {
  id         Int       @id @default(autoincrement())
  serverId   String
  userId     String
  /// Keyed hash of the voter's IP, to spot (and optionally limit) many accounts voting from one network
  ipHash     String
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  /// Which staff action revoked it: server | user. Restoring undoes exactly that.
  revokedFor String?
  server     Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id])

  @@index([serverId, createdAt])
  @@index([userId, createdAt])
  @@index([ipHash, createdAt])
}

/// Settings staff change from the portal, as JSON per key (e.g. "voting").
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Abuse reports and removal requests, reviewed on portal.yapboard.dev
model Report {
  id          String      @id @default(cuid())
  /// ABUSE | REMOVAL
  kind        String
  /// spam, scam, nsfw, hate, illegal, impersonation, other  |  owner_request, not_owner, outdated, other
  reason      String
  details     String
  contact     String?
  /// Exactly one of serverId / botId / clientId is set (src/lib/reports.ts).
  serverId    String?
  server      Server?     @relation(fields: [serverId], references: [id], onDelete: Cascade)
  botId       String?
  bot         BotListing? @relation(fields: [botId], references: [id], onDelete: Cascade)
  clientId    String?
  client      ClientListing? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reporterId  String?
  reporter    User?       @relation("reporter", fields: [reporterId], references: [id])
  /// OPEN | ACTIONED | DISMISSED
  status      String      @default("OPEN")
  resolution  String?
  handledById String?
  handledBy   User?       @relation("handler", fields: [handledById], references: [id])
  handledAt   DateTime?
  createdAt   DateTime    @default(now())

  @@index([status, kind, createdAt])
  @@index([serverId])
  @@index([botId])
  @@index([clientId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  /// e.g. report.dismiss, server.hide, server.remove, server.restore, user.ban, user.unban, staff.grant
  action     String
  targetType String
  targetId   String
  note       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/**
 * ---------------- Announcements (src/lib/announcements.ts) ----------------
 */

/// A site-wide notice staff write in the portal: a bar across the top of every page, or a dialog shown once.
model Announcement {
  id             String    @id @default(cuid())
  /// BANNER (a bar at the top) | MODAL (a dialog, shown once per person)
  kind           String    @default("BANNER")
  title          String
  body           String
  linkUrl        String?
  linkLabel      String?
  /// accent | info | warn | danger
  tone           String    @default("accent")
  /// everyone | users (logged in) | new (see newWithinHours)
  audience       String    @default("everyone")
  /// audience "new": accounts younger than this. Logged-out visitors always count as new.
  newWithinHours Int       @default(72)
  /// Banners only. A banner that isn't dismissible has no close button and comes back on every page.
  dismissible    Boolean   @default(true)
  /// Off: written but not shown. Staff turn it on when it's ready.
  active         Boolean   @default(false)
  startsAt       DateTime?
  endsAt         DateTime?
  authorId       String
  author         User      @relation(fields: [authorId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  seen AnnouncementSeen[]

  @@index([active, kind])
}

/// One person has closed one announcement. Logged-out visitors keep the same thing in their browser instead.
model AnnouncementSeen {
  announcementId String
  userId         String
  seenAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId])
}

/**
 * ---------------- Bot broadcasts (src/lib/broadcasts.ts) ----------------
 */

/// A message staff send through the bot to every server that has used /bump.
model Broadcast {
  id         String    @id @default(cuid())
  title      String
  body       String
  linkUrl    String?
  linkLabel  String?
  /// DRAFT | SENDING | SENT | CANCELLED
  status     String    @default("DRAFT")
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  deliveries BroadcastDelivery[]

  @@index([status, createdAt])
}

/// One server's copy of a broadcast. The bot claims PENDING rows, posts them and reports back.
model BroadcastDelivery {
  id          Int       @id @default(autoincrement())
  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  serverId    String
  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// The channel as it was when the broadcast was queued, so a later /bump elsewhere doesn't move it.
  channelId   String
  /// PENDING | CLAIMED | SENT | FAILED
  status      String    @default("PENDING")
  error       String?
  /// When the bot took this row. A claim left too long is handed out again (src/lib/broadcasts.ts).
  claimedAt   DateTime?
  sentAt      DateTime?

  @@unique([broadcastId, serverId])
  @@index([status, claimedAt])
}

/// One DM the bot owes someone, currently a bot listing review decision (src/lib/bot-dms.ts).
/// The site queues a row; the bot claims PENDING rows, sends them and reports back, like broadcasts.
/// The dashboard stays the real record — a DM is a nudge, so one that can't be delivered is logged, not retried forever.
model BotDm {
  id        Int       @id @default(autoincrement())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// bot.approved | bot.denied | client.approved | client.denied
  kind      String
  title     String
  body      String
  linkUrl   String?
  linkLabel String?
  /// PENDING | CLAIMED | SENT | FAILED
  status    String    @default("PENDING")
  error     String?
  /// When the bot took this row. A claim left too long is handed out again (src/lib/bot-dms.ts).
  claimedAt DateTime?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, claimedAt])
}

/**
 * ---------------- Bot listings (src/lib/bots.ts) ----------------
 */

/// A listed bot. `id` is the bot's Yapin' user id, the same one people paste into Server settings → Bots.
model BotListing {
  id              String    @id
  name            String
  avatarUrl       String?
  /// One line shown on cards (max 140)
  summary         String
  /// Full description shown on /bots/<id> (max 2000)
  description     String
  /// Optional "add me" link, for bots that have their own page
  inviteUrl       String?
  /// Message prefix, if it has one
  prefix          String?
  website         String?
  /// What it's written with, free text (e.g. "yapper.js")
  library         String?
  language        String    @default("en")
  nsfw            Boolean   @default(false)
  accent          String    @default("#ff6b4a")
  /// PENDING | PUBLIC | UNLISTED | DENIED | HIDDEN | REMOVED. New listings wait for staff (lib/bots.ts).
  status          String    @default("PENDING")
  /// Why staff denied, hid or removed it. Shown to the lister on their manage page.
  statusNote      String?
  /// Did the lister ask for unlisted? Remembered so approving sends it where they wanted.
  requestedUnlisted Boolean @default(false)
  /// Set when staff approved it, so the queue can show how long a decision took.
  reviewedAt      DateTime?
  reviewedById    String?
  serverCount     Int       @default(0)
  views           Int       @default(0)
  /// Clicks on "Add to your server"
  adds            Int       @default(0)
  bumpCount       Int       @default(0)
  bumpedAt        DateTime?
  /// The bot's support server. Set from a Yapin' server its lister manages; linked when that server is listed here.
  supportServerId String?
  supportServer   Server?   @relation("botSupport", fields: [supportServerId], references: [id], onDelete: SetNull)
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tags    BotTag[]
  badges  BotBadge[]
  bumps   BotBump[]
  reports Report[]

  @@index([status, bumpedAt])
  @@index([status, serverCount])
  /// The review queue: oldest PENDING first.
  @@index([status, createdAt])
  @@index([ownerId])
}

/// Same badges as servers (src/lib/badges.ts), granted on a bot instead.
model BotBadge {
  botId       String
  kind        String
  grantedAt   DateTime   @default(now())
  grantedById String?
  bot         BotListing @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([botId, kind])
  @@index([kind])
}

model BotTag {
  botId String
  tagId Int
  bot   BotListing @relation(fields: [botId], references: [id], onDelete: Cascade)
  tag   Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([botId, tagId])
  @@index([tagId])
}

model BotBump {
  id        Int        @id @default(autoincrement())
  botId     String
  userId    String
  createdAt DateTime   @default(now())
  bot       BotListing @relation(fields: [botId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])

  @@index([botId, createdAt])
}

/**
 * ---------------- Client listings (src/lib/clients.ts) ----------------
 */

/// A listed client: somebody's own build of Yapin', shipped as its own executable rather than a bot or a server.
/// Nothing about it lives on Yapin', so unlike a server or a bot there is no id to key it on — it gets a cuid and
/// a slug for its URL. Everything else (review queue, badges, tags, bumps, reports) works the way bots do.
model ClientListing {
  id          String  @id @default(cuid())
  /// The URL: /clients/<slug>. Made from the name on create, and kept when the name changes so links survive.
  slug        String  @unique
  name        String
  iconUrl     String?
  bannerUrl   String?
  /// One line shown on cards (max 140)
  summary     String
  /// Full description shown on /clients/<slug> (max 4000)
  description String
  /// Up to 6 https screenshots, as a JSON array of strings (SQLite has no array type).
  screenshots String?
  /// Which platforms the lister says it targets, as a JSON array of PLATFORM keys. Cards read this.
  platforms   String?
  website     String?
  /// Where the code is, when it isn't the GitHub repo below (a mirror, a GitLab page).
  sourceUrl   String?
  /// What it's built on, free text (e.g. "Electron", "Tauri")
  framework   String?
  language    String  @default("en")
  nsfw        Boolean @default(false)
  accent      String  @default("#ff6b4a")
  /// Hero backdrop on the listing page: GLOW | GRID | WAVE | FLAT (src/lib/clients.ts THEMES)
  theme       String  @default("GLOW")

  /// GITHUB (downloads come from releases/latest) | MANUAL (the lister keeps the links themselves)
  releaseSource String @default("GITHUB")
  /// "owner/repo" when releaseSource is GITHUB. Releases are read from it; nothing is ever written back.
  repo          String?
  /// The tag of the release currently shown, e.g. "v1.4.2".
  version       String?
  /// The release's own title, when it has one that isn't just the tag.
  releaseName   String?
  /// The release notes, shown as the changelog. Markdown-ish, rendered as plain text with links.
  changelog     String?
  releaseUrl    String?
  releasedAt    DateTime?
  /// When the release was last read from GitHub, and what went wrong if it couldn't be.
  releaseSyncedAt DateTime?
  releaseError    String?

  /// PENDING | PUBLIC | UNLISTED | DENIED | HIDDEN | REMOVED. New listings wait for staff, like bots.
  status            String    @default("PENDING")
  statusNote        String?
  requestedUnlisted Boolean   @default(false)
  reviewedAt        DateTime?
  reviewedById      String?
  /// When the lister accepted the YapBoard client terms and Yapin's terms in the dialog before submitting.
  termsAgreedAt     DateTime?

  views     Int       @default(0)
  /// Clicks on a download button, across every file.
  downloads Int       @default(0)
  bumpCount Int       @default(0)
  bumpedAt  DateTime?

  /// The client's support or community server, as a Yapin' server id the lister runs.
  supportServerId String?
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tags    ClientTag[]
  badges  ClientBadge[]
  bumps   ClientBump[]
  files   ClientDownload[]
  reports Report[]

  @@index([status, bumpedAt])
  @@index([status, downloads])
  /// The review queue: oldest PENDING first.
  @@index([status, createdAt])
  @@index([ownerId])
}

/// One file people can download for a client. Either read from a GitHub release or typed in by the lister.
model ClientDownload {
  id       Int           @id @default(autoincrement())
  clientId String
  client   ClientListing @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// windows | mac | linux | android | ios | web | other (src/lib/platforms.ts)
  platform String
  /// The file's extension as a label: exe, dmg, deb, AppImage… Blank for a plain link.
  kind     String        @default("")
  /// x64 | arm64 | x86 | universal | '' when the name doesn't say
  arch     String        @default("")
  /// What the button says, e.g. "YapinPlus-1.4.2-x64.exe"
  label    String
  url      String
  /// Bytes, when the release says. Null for links the lister typed in.
  size     Int?
  /// True: this row came from the GitHub release and is replaced on every sync. False: the lister owns it.
  managed  Boolean       @default(true)
  /// Manual rows sort by this, then by label.
  position Int           @default(0)
  /// Clicks on this file's button.
  clicks   Int           @default(0)

  @@index([clientId, platform])
}

/// Same badges as servers and bots (src/lib/badges.ts), granted on a client.
model ClientBadge {
  clientId    String
  kind        String
  grantedAt   DateTime      @default(now())
  grantedById String?
  client      ClientListing @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, kind])
  @@index([kind])
}

model ClientTag {
  clientId String
  tagId    Int
  client   ClientListing @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag      Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
  @@index([tagId])
}

model ClientBump {
  id        Int           @id @default(autoincrement())
  clientId  String
  userId    String
  createdAt DateTime      @default(now())
  client    ClientListing @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  @@index([clientId, createdAt])
}

/// An image somebody uploaded on YapBoard, rather than linking from somewhere else.
///
/// The bytes live in the database so an upload travels with the volume and with any backup of it, the same
/// way everything else here does — there is no second store to keep in sync. They're small on purpose (see
/// MAX_UPLOAD_BYTES in src/lib/upload-fields.ts); if this ever grows past a few hundred megabytes, move the
/// `data` column to object storage and keep the rest of the row as it is.
///
/// Served at /u/<id>.<ext> (src/app/u/[file]/route.ts), which is what a listing stores in place of a link.
/// Rows nothing points at are swept a day after they're made (sweepUploads in src/lib/uploads.ts), so an
/// image picked and then replaced in the form doesn't stay forever.
model Upload {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// image/png | image/jpeg | image/webp | image/gif, read from the file's own first bytes, never from the browser.
  mime      String
  /// png | jpg | webp | gif — the extension the URL ends in, so the path still looks like a file.
  ext       String
  bytes     Int
  /// What it was picked for: icon | banner | screenshot. Sets the size limit, and tells staff what they're looking at.
  kind      String
  data      Bytes
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([createdAt])
}
