# --- Database (SQLite for dev; switch provider to postgresql in schema.prisma for prod) ---
DATABASE_URL="file:./dev.db"

# --- Sessions: long random string (openssl rand -base64 48) ---
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- Public URLs ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
PORTAL_URL="http://localhost:3000/portal"
# The invite-only developer platform (src/lib/platform.ts)
PLATFORM_URL="http://localhost:3000/platform"
# The API's own host (https://api.yapboard.dev in prod). Leave blank in dev: the platform docs then point
# members' bots at this site's own /api, which is callable locally.
API_URL=""
# Set to .yapboard.dev in prod so the session works on portal. and platform.yapboard.dev too
COOKIE_DOMAIN=""

# --- Login with Yapin' (Settings -> Developer -> Login with Yapin') ---
# Leave blank in dev to use the local dev login instead.
YAPIN_CLIENT_ID=""
YAPIN_CLIENT_SECRET=""

# --- YapBoard bot (same token the /Bot uses). Used to verify server ownership. ---
# Leave blank in dev: ownership checks are skipped and you can list any server ID.
YAPPER_BOT_TOKEN=""
NEXT_PUBLIC_BOT_ID=""

# --- Optional. Client listings read their downloads from GitHub releases; a token only raises the rate limit
# (60 requests an hour per IP becomes 5,000). Read-only, no scopes needed - a fine-grained token with public
# read access is enough. Nothing is ever written to GitHub. ---
GITHUB_TOKEN=""

# --- Shared secret the bot uses to call /api/internal/* ---
INTERNAL_API_SECRET="change-me-too"

# --- "Report a bug" in the footer posts to this Kern stream, straight from the browser (public stream: no secret
# here, ever). Baked in at build time. Leave blank to hide the button. ---
NEXT_PUBLIC_BUG_REPORT_URL="https://streams.relf.cc/kern/9193cd4b7891377b3caa4f430b25d41d3785b5d0909ee20d94c8ad35a54009bf"

# --- Comma separated Yapin' user IDs that are always staff (admins) ---
STAFF_IDS=""

# --- Stripe, for YapBoard Pro (src/lib/stripe.ts). Pro is off unless all four are set. ---
# Prefer a RESTRICTED key (rk_test_… / rk_live_…) over a secret key: give it only the Billing,
# Checkout, Customer and Customer Portal write permissions Pro actually uses. Never commit a real key.
STRIPE_SECRET_KEY=""
# Safe in the browser by design; this is the only Stripe value that may be NEXT_PUBLIC_*. Nothing
# reads it yet - Checkout and the Portal are hosted by Stripe, so no Stripe.js runs here.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# In dev: `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints it.
# In prod: Dashboard -> Developers -> Webhooks, endpoint https://yapboard.dev/api/stripe/webhook
# Events to send: checkout.session.completed, customer.subscription.created/updated/deleted,
# invoice.paid, invoice.payment_failed, charge.dispute.created, charge.refunded,
# radar.early_fraud_warning.created
STRIPE_WEBHOOK_SECRET=""
# Two Products, each with a Price per billing cycle:
#   "YapBoard Pro"                 - the base plan: one server, one bot and one client
#   "YapBoard Pro extra listing"   - one more listing of any kind, bought with a quantity
# Two Products rather than one because an invoice line shows the Product name, so sharing one would
# print "YapBoard Pro" twice and the buyer couldn't tell the base plan from the extras.
# Both Products need a `tax_code` set (Managed Payments refuses a line item without one).
#
# Every Price needs metadata `yapboard_role` = base | slot. This is not optional: the webhook counts
# extra slots and finds the base line by that field alone (src/lib/stripe.ts), because repricing means
# creating a new Price - matching on an env var's id would zero every subscriber's slots the day the id
# changed. `yapboard_cycle` = monthly | annual is optional; without it the cycle is read off the interval.
#
#   USD, recurring, licensed, quantity on the slot prices. Amounts must match PRICING in
#   src/lib/pro-fields.ts - `node scripts/check-prices.mjs` (npm run check:prices) checks all of this.
#
#   yb_pro_monthly    $2.99 / month   role=base   STRIPE_PRICE_PRO_MONTHLY
#   yb_pro_annual    $29.99 / year    role=base   STRIPE_PRICE_PRO_ANNUAL
#   yb_slot_monthly   $1.00 / month   role=slot   STRIPE_PRICE_SLOT_MONTHLY
#   yb_slot_annual   $10.00 / year    role=slot   STRIPE_PRICE_SLOT_ANNUAL
#
# No trial on the Price: the 14 days are passed per session as `trial_period_days` (TRIAL_DAYS).
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_SLOT_MONTHLY=""
STRIPE_PRICE_SLOT_ANNUAL=""
