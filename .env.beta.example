# YapBoard beta (beta.yapboard.dev) - copy to .env.beta and fill in.
#
#   docker compose -p yapboard-beta --env-file .env.beta -f docker-compose.beta.yml up -d --build
#
# Every value here must differ from production except the two marked "same as production". Where a variable
# is absent from this file it is absent on purpose; see docker-compose.beta.yml for why.

# --- What makes this the beta -------------------------------------------------------------------------
# Presence turns on the badge in the navbar and the bar across the top, and switches on the interlocks in
# Site/src/lib/beta.ts. It is baked into the bundle at build time, so changing it means rebuilding.
NEXT_PUBLIC_BETA_VERSION="v1.10"

# --- Public URLs --------------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://beta.yapboard.dev"
# Paths, not subdomains: Cloudflare's universal certificate does not cover portal.beta.yapboard.dev.
PORTAL_URL="https://beta.yapboard.dev/portal"
PLATFORM_URL="https://beta.yapboard.dev/platform"
API_URL=""

# NOT SET, and the site refuses to start if you set it: a cookie scoped to .yapboard.dev is sent to the real
# site too, which would make beta and production one login.
# COOKIE_DOMAIN=

# --- Secrets ------------------------------------------------------------------------------------------
# Its own, so that a session minted here is worthless on the real board and vice versa.
#   openssl rand -base64 48
SESSION_SECRET="change-me-to-something-random-48-chars-or-more"
# Its own too. The bot and site talk over the Docker network inside this project only.
INTERNAL_API_SECRET="change-me-to-something-random"

# --- Login with Yapin' --------------------------------------------------------------------------------
# Same as production: the same OAuth app, with https://beta.yapboard.dev/api/auth/callback added to its
# redirect URIs. Anyone with a Yapin' account can then log in to the beta.
YAPIN_CLIENT_ID=""
YAPIN_CLIENT_SECRET=""

# --- The beta bot -------------------------------------------------------------------------------------
# A SECOND Yapin' bot application, never the live token. Invite it to one server you own and nothing else:
# the beta database is full of real accounts, and this bot can reach them. DMs are limited to STAFF_IDS and
# broadcasts never leave (Site/src/lib/beta.ts), but the token itself is the last line of that.
YAPPER_BOT_TOKEN=""
NEXT_PUBLIC_BOT_ID=""

# --- Staff --------------------------------------------------------------------------------------------
# Who can reach the portal, and - on beta only - the only people the bot will DM.
STAFF_IDS=""
# The single account that owns YapBoard. Optional: defaults to the first STAFF_IDS entry.
OWNER_ID=""

# --- Cloudflare ---------------------------------------------------------------------------------------
# A tunnel of its own, with beta.yapboard.dev -> http://caddy:80 as its only public hostname.
TUNNEL_TOKEN=""

# --- Optional -------------------------------------------------------------------------------------------
GITHUB_TOKEN=""
NEXT_PUBLIC_BUG_REPORT_URL=""

# --- Deliberately absent --------------------------------------------------------------------------------
# All six STRIPE_* variables. Without them billingEnabled() is false and every billing route answers 503,
# which is what stops a beta taking real money. The copied ProSubscription rows still grant Pro, so the
# ranking boost and the PROMOTED label are both testable without a key.
